# /etc/flange-std/env —— 法兰标准库生产环境变量（chmod 600，deploy:deploy）
# 由 deploy/setup-server.sh 首次生成；改完 systemctl restart flange-std。

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-openssl-rand-hex-32
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,std.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://std.example.com
DJANGO_HTTPS=1
SITE_URL=https://std.example.com
# 挂在主域名子路径时设置（例如 https://ax-forge.com/std/ -> /std）；独立子域名留空
# DJANGO_SCRIPT_NAME=/std

# PDF 生成（Playwright + Chromium）
PLAYWRIGHT_BROWSERS_PATH=/var/lib/flange-std/ms-playwright
PDF_CACHE_DIR=/var/lib/flange-std/pdf
# 内部渲染地址：子域名部署用 https://std.example.com；路径挂载用 https://127.0.0.1/std
PDF_RENDER_BASE_URL=https://std.example.com
PDF_LAYOUT_VERSION=1

# SQLite（默认）。数据库放在 /var/lib 下，方便单独备份，不随代码发布被覆盖。
DJANGO_DB_PATH=/var/lib/flange-std/db.sqlite3

# 可选：切 PostgreSQL 时取消注释并填好（同时需要 pip install psycopg[binary]）
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=flange_std
# DJANGO_DB_USER=flange
# DJANGO_DB_PASSWORD=change-me
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# Gunicorn
GUNICORN_WORKERS=3
