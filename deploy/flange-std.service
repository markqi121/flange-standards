[Unit]
Description=法兰标准库 (Django + Gunicorn)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/flange-std/app
EnvironmentFile=/etc/flange-std/env
ExecStart=/srv/flange-std/venv/bin/gunicorn stdlib_site.wsgi:application -c /srv/flange-std/app/deploy/gunicorn.conf.py
Restart=always
RestartSec=3
TimeoutStopSec=30

# 基本加固：代码目录只读，数据库目录可写
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/flange-std

[Install]
WantedBy=multi-user.target
